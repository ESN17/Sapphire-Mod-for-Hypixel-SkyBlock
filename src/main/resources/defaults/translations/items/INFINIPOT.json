  "_original_lore": [
    "Accessory Power: +8",
    "",
    "Upon starting a floor in The",
    "Catacombs, automatically consumes",
    "the selected Dungeon Potion from",
    "your inventory or Potion Bag.",
    "",
    "If you do not have the selected",
    "potion in your inventory or Potion",
    "Bag, it will be purchased and",
    "consumed automatically using Coins",
    "from your purse or bank.",
    "",
    "Selected Potion: Dungeon I Potion",
    "Left-click to select a potion!",
    "",
    "Enabled: On",
    "Right-click to toggle!",
    "",
    "“Alixer’s latest and greatest",
    "creation!”",
    "",
    "Works while in Accessory Bag!",
    "RARE DUNGEON ACCESSORY"
  ],
