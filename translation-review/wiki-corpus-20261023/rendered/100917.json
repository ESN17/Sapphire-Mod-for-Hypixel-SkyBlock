    "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><div class=\"messagebox\" style=\"\">\n<div class=\"messagebox-main\">\n<div class=\"messagebox-image nomobile\" style=\"\">\n<p><span class=\"notpageimage\" typeof=\"mw:File\"><a href=\"/w/File:Jukebox.png\" class=\"mw-file-description\"><img src=\"/images/thumb/Jukebox.png/64px-Jukebox.png?19bed\" decoding=\"async\" loading=\"lazy\" width=\"64\" height=\"64\" class=\"mw-file-element\" srcset=\"/images/thumb/Jukebox.png/128px-Jukebox.png?19bed 2x\" data-file-width=\"300\" data-file-height=\"300\" /></a></span>\n</p>\n</div>\n<div class=\"messagebox-text\" style=\"\">\n<p><b>Century Raffle Exclusive</b><br />\n<b>Random Century Cake Bundle</b> is only obtainable during <a href=\"/w/Raffle_of_the_Century\" title=\"Raffle of the Century\">century celebrations</a>.\n</p>\n</div>\n</div>\n<div class=\"messagebox-aside\">\n</div>\n</div> \n<div class=\"infobox\"><div class=\"infobox-title\">Random Century Cake Bundle</div><div class=\"infobox-panel\"><ul class=\"infobox-section-labels\"><li class=\"label-active\" style=\"display:none\"></li></ul><div class=\"section active\"><div class=\"infobox-row-container\"><div class=\"infobox-row-value\">\n<div style=\"text-align: center;\"><span><span class=\"mw-default-size pi-image-thumbnail\" typeof=\"mw:File\"><a href=\"/w/File:Random_Century_Cake_Bundle.png\" class=\"mw-file-description\" title=\"Random Century Cake Bundle.png\"><img alt=\"Random Century Cake Bundle.png\" src=\"/images/Random_Century_Cake_Bundle.png?f5848\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"300\" class=\"mw-file-element\" data-file-width=\"300\" data-file-height=\"300\" /></a></span></span></div></div></div><div class=\"infobox-row-container\"><div class=\"infobox-row-value\">\n<div style=\"text-align: center;\"><div class=\"\"><div class=\"mcui-row\"><span class=\"invslot\"><span class=\"invslot-item invslot-item-image\" data-minetip-style=\"legendary\" data-minetip-title=\"&amp;6Random Century Cake Bundle\" data-minetip-text=\"&amp;8Consumable//&amp;7Consume to unwrap a randomized/&amp;7assortment of &amp;d5 &amp;7century cakes.//&amp;eRight-click to consume!//&amp;6&amp;lLEGENDARY\"><span typeof=\"mw:File\"><span title=\"Random Century Cake Bundle\"><img alt=\"Random Century Cake Bundle.png\" src=\"/images/thumb/Random_Century_Cake_Bundle.png/32px-Random_Century_Cake_Bundle.png?f5848\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/Random_Century_Cake_Bundle.png/64px-Random_Century_Cake_Bundle.png?f5848 2x\" data-file-width=\"300\" data-file-height=\"300\" /></span></span></span></span></div></div></div></div></div><div class=\"infobox-row-container\"><div class=\"infobox-row-label\">Type</div><div class=\"infobox-row-value\">\nItem</div></div><div class=\"infobox-row-container\"><div class=\"infobox-row-label\">Rarity</div><div class=\"infobox-row-value\">\n<span data-sort-value=\"4\"><a href=\"/w/Rarity#Legendary\" title=\"Rarity\"><span class=\"hsw-gamefont raritytier\"><span class=\"color-gold\" style=\"\">LEGENDARY</span></span></a></span></div></div><div class=\"group layout-horizontal\" style=\"display:grid;grid-template-columns:repeat(2, 1fr);grid-column:1 / -1\"><div class=\"infobox-header\">Item Properties</div><div class=\"infobox-row-container\"><div class=\"infobox-row-label\"><abbr title=\"Whether or not the item(s) can be sold to an NPC. If an item is not salable but has enchantments on it, it becomes salable.\" tabindex=\"0\">Salable</abbr></div><div class=\"infobox-row-value\">\n<span class=\"mcui-text\" style=\"display: inline; font-size: 12px;\"><span class=\"format-c\">✕</span></span> <span class=\"color-red\" style=\"\"><b>No</b></span></div></div><div class=\"infobox-row-container\"><div class=\"infobox-row-label\">Tradeable</div><div class=\"infobox-row-value\">\n<span class=\"mcui-text\" style=\"display: inline; font-size: